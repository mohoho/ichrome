{
  "manifest_version": 3,
  "name": "iChrome",
  "version": "1.3.1",
  "description": "你的 AI 浏览器控制助手：复用 Chrome 登录状态，读取网页、填写表单、执行自动化任务。",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "iChrome · AI 浏览器控制"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "downloads",
    "sidePanel",
    "notifications",
    "debugger"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "short_name": "iChrome"
}
